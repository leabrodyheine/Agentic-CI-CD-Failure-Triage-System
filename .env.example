# GitHub personal access token with `repo` and `actions:read` scope on the target repo.
GITHUB_TOKEN=

# Repo to watch, in "owner/name" form.
GITHUB_REPO=

# Anthropic API key used for classification and root-cause hypothesis generation.
ANTHROPIC_API_KEY=

# Seconds between polls when running `triage poll` without --once. Optional, default: 60.
POLL_INTERVAL_SECONDS=60

# Path to the SQLite audit log. Optional, default: triage.db.
TRIAGE_DB_PATH=triage.db

# When true, runs the full pipeline and logs the decision, but does not file a GitHub issue.
# Optional, default: false.
TRIAGE_DRY_RUN=false

# Minimum classification confidence (0-1) required to file an issue. Below this, the pipeline
# still runs and the decision is still logged, just not filed. Optional, default: 0.0 (always file).
TRIAGE_MIN_CONFIDENCE_TO_FILE=0.0
